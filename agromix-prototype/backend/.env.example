# Copy this file to ".env" (same folder) and fill in your real keys.
# NEVER commit the real .env file to GitHub — add .env to .gitignore.

OPENWEATHER_API_KEY=paste_your_openweathermap_key_here

# Optional, only needed once you wire up real Twilio webhooks
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
